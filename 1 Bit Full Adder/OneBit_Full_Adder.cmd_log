xst -intstyle ise -ifn "/home/ise/VLSI_Projects/One_Bit_FullAdder/OneBit_Full_Adder.xst" -ofn "/home/ise/VLSI_Projects/One_Bit_FullAdder/OneBit_Full_Adder.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc6slx4-tqg144-3 OneBit_Full_Adder.ngc OneBit_Full_Adder.ngd  
map -intstyle ise -p xc6slx4-tqg144-3 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o OneBit_Full_Adder_map.ncd OneBit_Full_Adder.ngd OneBit_Full_Adder.pcf 
